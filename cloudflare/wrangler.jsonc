{
    "$schema": "./node_modules/wrangler/config-schema.json",

    "name": "mini-haven-multiplayer",

    "main": "src/index.js",

    "compatibility_date": "2026-08-11",

    "durable_objects": {
        "bindings": [
            {
                "name": "GAME_ROOM",
                "class_name": "GameRoom"
            }
        ]
    },

    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "GameRoom"
            ]
        }
    ]
}
